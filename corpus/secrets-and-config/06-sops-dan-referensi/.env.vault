#/-------------------.env.vault---------------------/
#/         cloud-agnostic vaulting standard         /
#/   [how it works](https://dotenv.org/env-vault)   /
#/--------------------------------------------------/

# Berkas ini menggantikan salinan .env per lingkungan yang dulu beredar lewat pesan pribadi.
#
# Isinya ciphertext, jadi ia boleh masuk Git: yang membukanya adalah DOTENV_KEY, satu nilai per
# lingkungan yang hanya ada di runner deploy dan di manajer rahasia. Proses membaca
# DOTENV_KEY_PRODUCTION saat start, mendekripsi blok yang sesuai di memori, lalu menempatkan
# hasilnya ke process.env — tidak ada berkas teks biasa yang pernah menyentuh disk.
#
# Yang tetap harus dijaga: DOTENV_KEY itu sendiri. Ia satu kunci untuk seluruh lingkungan,
# sehingga bocornya sama dengan bocornya semua nilai di bawah sekaligus. Karena itu partner
# portal dan identity-service tidak memakai mekanisme ini sama sekali dan tetap lewat Vault.
#
# Perintah yang dipakai tim: `npx dotenv-vault@latest build` setelah setiap perubahan .env di
# dotenv.org, lalu commit berkas ini apa adanya.

#/----------------production-----------------/
DOTENV_VAULT_PRODUCTION=""

#/----------------staging--------------------/
DOTENV_VAULT_STAGING=""

#/----------------ci-------------------------/
DOTENV_VAULT_CI=""

#/----------------pengaturan-----------------/
DOTENV_VERSION="1.28.0"
DOTENV_VAULT_ID="vlt_9f3c72ad51e84b6a8d271c05fe83b4d9"
DOTENV_VAULT_SERVICES="document-service,notification-service,partner-portal-api"
