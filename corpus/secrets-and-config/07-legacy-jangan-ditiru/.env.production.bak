# PERINGATAN: cadangan .env produksi, ikut ter-commit dan tidak boleh dijadikan contoh.
#
# Berkas ini dibuat seorang teknisi pada 2024-06-11 dengan menyalin isi Secret Kubernetes
# `platform-env` di namespace of-platform ke laptopnya sebelum migrasi ke Vault, "supaya ada
# jalan pulang kalau rollout gagal". Rollout-nya berhasil, cadangannya tidak pernah dihapus,
# dan tiga bulan kemudian berkas ini ikut terbawa `git add .` bersama direktori kerjanya.
#
# Setiap nilai di bawah pernah hidup di produksi eu-west. Sebagian sudah dirotasi setelah audit
# 2026-01; yang belum ditandai per baris. Menghapus berkas ini tidak mencabut apa pun — yang
# mencabut adalah rotasi di sisi penyedia — jadi urutannya: rotasi dulu, hapus berkas kemudian,
# lalu tulis ulang riwayat Git kalau memang diputuskan begitu.
#
# Bentuk yang benar untuk seluruh isi berkas ini: ../06-sops-dan-referensi/production.eu-west.enc.yaml
# untuk nilai yang boleh masuk Git, dan ../03-vault/approle-login.sh untuk yang tidak boleh.

# --- Identitas proses (§5.1) -------------------------------------------------------------------
OF_ENVIRONMENT=production
OF_REGION_CODE=eu-west
OF_SERVICE_NAME=container-registry
OF_LOG_LEVEL=info
OF_LOG_FORMAT=json
OF_HTTP_PORT=8083
OF_GRPC_PORT=9083
OF_SHUTDOWN_GRACE_SECONDS=25
OF_OUTBOX_RELAY_INTERVAL_MS=250

# --- Basis data ---------------------------------------------------------------------------------
# BELUM DIROTASI. Peran of_platform masih memakai kata sandi yang sama sejak 2023 dan juga
# muncul di config.production.yaml di direktori ini.
OF_DATABASE_URL=postgres://of_platform:__PLANTED_PGURL__@pg-eu-west-primary.orbitalfreight.internal:5432/orbitalfreight?search_path=freight&sslmode=verify-full
OF_DATABASE_MAX_CONNS=40
OF_DATABASE_STATEMENT_TIMEOUT_MS=8000

# BELUM DIROTASI. Peran hanya-baca analytics-pipeline; sama dengan yang ada di credentials.ini.
OF_ANALYTICS_READONLY_DATABASE_URL=postgres://of_analytics_ro:__PLANTED_PGURL__@pg-eu-west-replica.orbitalfreight.internal:5432/orbitalfreight?sslmode=verify-full

# --- Kafka --------------------------------------------------------------------------------------
OF_KAFKA_BROKERS=kafka-0.eu-west.orbitalfreight.internal:9092,kafka-1.eu-west.orbitalfreight.internal:9092
OF_KAFKA_CONSUMER_GROUP=container-registry-v3
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=of-container-registry
# DIROTASI 2026-01-22. Nilai lama, disimpan karena dua konsumen di depot masih tertinggal.
KAFKA_SASL_PASSWORD=Vb8Th1Yg5Fc0Ae2Ru7Dk

# --- identity-service ---------------------------------------------------------------------------
OF_IDENTITY_GRPC_ADDR=identity-service:9081
OF_IDENTITY_JWKS_URL=http://identity-service:8081/.well-known/jwks.json
OF_IDENTITY_JWKS_GRACE_SECONDS=300
OF_IDENTITY_SIGNING_KEY_PATH=/etc/orbitalfreight/legacy/identity-signing-2024.pem
OF_IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
OF_IDENTITY_REFRESH_TOKEN_TTL_DAYS=30
OF_IDENTITY_ARGON2_MEMORY_KIB=65536
OF_IDENTITY_MFA_ISSUER=ORBITALFREIGHT
OF_IDENTITY_MAX_ORG_DEPTH=12

# --- Penyimpanan objek dan dokumen --------------------------------------------------------------
# BELUM DIROTASI. Pengguna IAM of-document-writer; sama dengan pasangan kunci di credentials.ini.
AWS_ACCESS_KEY_ID=__PLANTED_AWS_KEY__
AWS_SECRET_ACCESS_KEY=wJz3Kd7Qm2Lp9Xr4Ns6Vb8Th1Yg5Fc0Ae2Ru7DkP
AWS_DEFAULT_REGION=eu-west-1
OF_DOCUMENT_BUCKET=of-documents-eu-west
OF_DOCUMENT_KMS_KEY_ID=arn:aws:kms:eu-west-1:481920377154:key/6a1f0c48-2d7b-4f83-9c15-b0e4d2a97f31
OF_DOCUMENT_SIGNED_URL_TTL_SECONDS=900
OF_DOCUMENT_MAX_UPLOAD_BYTES=52428800
OF_DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/xml

# --- notification-service -----------------------------------------------------------------------
OF_NOTIFY_SMTP_URL=smtps://notifications@orbitalfreight.io:Rk3mZ9xTvB5dLpYc@smtp.eu-west.orbitalfreight.internal:465
# BELUM DIROTASI. Token Twilio produksi; pasangannya __PLANTED_TWILIO_SID__.
OF_NOTIFY_SMS_PROVIDER_TOKEN=d41c8f5a7b2e93d06f4a1c8b5e7d3902
OF_NOTIFY_PUSH_APNS_KEY_PATH=/etc/orbitalfreight/legacy/apns-driver-ios-2024.p8
OF_NOTIFY_PUSH_FCM_KEY_PATH=/etc/orbitalfreight/legacy/fcm-inspector-android-2024.json
OF_NOTIFY_WEBHOOK_TIMEOUT_MS=4000
OF_NOTIFY_MAX_ATTEMPTS=8
OF_NOTIFY_TEMPLATE_DIR=/etc/orbitalfreight/templates

# --- customs-service ----------------------------------------------------------------------------
OF_CUSTOMS_AUTHORITY_ENDPOINT=https://filing.douane.gouv.example/edifact/v2
OF_CUSTOMS_AUTHORITY_CERT_PATH=/etc/orbitalfreight/legacy/authority-client-2023.pem
# Frasa sandi sertifikat klien di atas. Ditulis di sini persis seperti di config.production.yaml.
OF_CUSTOMS_AUTHORITY_CERT_PASSPHRASE=brumaire-1799
OF_CUSTOMS_TARIFF_CACHE_TTL_SECONDS=86400
OF_CUSTOMS_RETENTION_YEARS=10

# --- billing-service ----------------------------------------------------------------------------
OF_BILLING_INVOICE_NUMBER_FORMAT=OF-{tenant_short}-{year}-{seq:06d}
OF_BILLING_DEFAULT_PAYMENT_TERMS_DAYS=30
OF_BILLING_FX_RATE_SOURCE=openexchange
OF_BILLING_HOLD_ON_DISCREPANCY_KINDS=amount_mismatch,missing_declaration
# DIROTASI 2026-01-22 setelah audit. Kunci lama, tetap terbaca sebagai kunci Stripe yang sah.
OF_BILLING_STRIPE_SECRET_KEY=__PLANTED_STRIPE__
OF_BILLING_STRIPE_WEBHOOK_SECRET=whsec_2mZr9xTvB5dLpYcH8wJgE4aUdTr3nQ7k

# --- Otomatisasi rilis --------------------------------------------------------------------------
# PAT berbutir halus milik akun mesin of-release-bot, cakupan contents:write pada satu repositori.
GITHUB_TOKEN=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
# Kanal siaga ops; webhook lama yang tidak memerlukan token bot.
SLACK_WEBHOOK_URL=__PLANTED_SLACK_WEBHOOK__

# --- Kunci pembuka .env.vault -------------------------------------------------------------------
# Inilah baris yang paling merugikan di berkas ini: satu nilai yang membuka seluruh isi
# ../06-sops-dan-referensi/.env.vault untuk semua lingkungan sekaligus.
DOTENV_KEY=dotenv://:key_7f3e91b0c25d4a86bf19d3705e2c4a819d0b6e4f28a71c3d5e6f8091a2b3c4d5@dotenv.org/vault/.env.vault?environment=production

