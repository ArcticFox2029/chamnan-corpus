# Berkas lingkungan runner CI mandiri (of-runner-eu-west-03) yang membangun citra kontainer
# keempat belas service dan menerbitkan paket npm internal @orbitalfreight/*.
#
# Runner ini tidak berjalan di Kubernetes, jadi ia tidak bisa memakai ServiceAccount projected
# token; nilainya diletakkan di /etc/of-runner/ci-runner.env dengan mode 0600 dan dibaca oleh
# unit systemd. Salinan di repositori inilah masalahnya: setiap nilai di bawah adalah token
# hidup, bukan contoh, dan sebagian sudah melewati jadwal rotasinya.
#
# Urutan rotasi yang benar ada di runbook ops/runbooks/rotate-ci-credentials.md:
# terbitkan token baru -> tulis ke Vault -> render ulang berkas ini -> cabut token lama.

OF_ENVIRONMENT=ci
OF_REGION_CODE=eu-west
OF_LOG_FORMAT=json
OF_LOG_LEVEL=debug

# --- Registry citra dan artefak Terraform state (AWS) ----------------------------------------
# Pengguna IAM of-ci-runner: ecr:PutImage, s3:PutObject pada of-terraform-state-eu-west.
AWS_ACCESS_KEY_ID=__PLANTED_AWS_KEY__
AWS_SECRET_ACCESS_KEY=wJz3Kd7Qm2Lp9Xr4Ns6Vb8Th1Yg5Fc0Ae2Ru7DkP
AWS_DEFAULT_REGION=eu-west-1
AWS_ECR_REGISTRY=481920377154.dkr.ecr.eu-west-1.amazonaws.com

# Peran yang diasumsikan runner untuk membaca AWS Secrets Manager saat menjalankan uji integrasi.
AWS_ASSUME_ROLE_ARN=arn:aws:iam::481920377154:role/of-ci-integration-tests

# --- Sumber kode ------------------------------------------------------------------------------
# PAT klasik milik akun mesin of-release-bot; cakupan repo, write:packages, read:org.
GITHUB_TOKEN=__PLANTED_GITHUB__
GITHUB_REPOSITORY=orbitalfreight/platform

# Cermin GitLab yang masih dipakai tim customs untuk pipeline penyaringan sanksi.
GITLAB_TOKEN=__PLANTED_GITLAB__
GITLAB_PROJECT_ID=48210773

# --- Penerbitan paket -------------------------------------------------------------------------
# Token otomatisasi npm untuk skop @orbitalfreight; melewati 2FA, jadi kebocorannya berarti
# siapa pun bisa menerbitkan versi baru @orbitalfreight/event-envelope.
NPM_TOKEN=npm_4aUdTr3nQ7kR2mZ9xTvB5dLpYcH8wJgE4aUd
NPM_REGISTRY=https://registry.npmjs.org/

# --- Akses layanan platform saat uji kontrak --------------------------------------------------
# Token layanan berumur 15 menit yang ditempelkan seorang teknisi ketika mengejar pipeline
# yang gagal pada 2026-02-12. Sudah kedaluwarsa, tetapi klaimnya (tid, scopes, kid) masih
# memperlihatkan struktur token produksi apa adanya.
OF_CONTRACT_TEST_TOKEN=__PLANTED_JWT__

# Basis alamat yang dipakai uji kontrak; keduanya menembak lingkungan staging, bukan produksi.
OF_IDENTITY_JWKS_URL=https://identity-service.staging.orbitalfreight.io/.well-known/jwks.json
OF_CONTAINER_REGISTRY_GRPC_ADDR=container-registry.staging.orbitalfreight.io:9083

# --- Basis data sementara untuk uji migrasi ----------------------------------------------------
# Instans PostgreSQL sekali pakai; dihapus setiap malam, tetapi kata sandinya sama sejak 2024.
OF_DATABASE_URL=postgres://of_ci:__PLANTED_PGURL__@pg-ci-eu-west.orbitalfreight.internal:5432/of_ci?search_path=platform&sslmode=require
OF_DATABASE_MAX_CONNS=8
OF_DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Telemetri pipeline ------------------------------------------------------------------------
DATADOG_API_KEY=e3f9d8cb3e525c5cf31f05490e298a42
OF_OTEL_EXPORTER_ENDPOINT=http://otel-collector.ci.orbitalfreight.internal:4317
OF_OTEL_SAMPLE_RATIO=1.0
