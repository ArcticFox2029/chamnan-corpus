# =============================================================================
# Prostředí agenta depotní brány. Generuje role of_edge_gateway.
#
# Agent není jednou ze čtrnácti služeb z §1 SPEC.md a nemá vlastní sekci v §5,
# ale drží se stejné konvence prefixu OF_ a stejných jednotek (§0.2): metry,
# kilogramy, stupně Celsia, časy v RFC 3339 UTC.
#
# NEEDITOVAT NA STROJI. Přepíše první běh site.yml.
# =============================================================================

OF_ENVIRONMENT={{ of_environment }}
OF_REGION_CODE={{ of_region }}
OF_SERVICE_NAME=edge-gateway-agent
OF_LOG_LEVEL={{ of_log_level }}
OF_LOG_FORMAT={{ of_log_format }}

# Identita brány. Sériové číslo odpovídá telemetry.device_gateways.serial,
# depot je logický cizí klíč do fleet.depots.
OF_EDGE_GATEWAY_SERIAL={{ of_gateway_serial }}
OF_EDGE_DEPOT_ID={{ of_depot_id }}
OF_EDGE_SIGNING_KEY_PATH={{ of_edge_signing_key_path }}

# Cíle. gRPC varianta se používá tam, kde má depo stabilní linku — pak jede
# telemetry.v1.TelemetryIngest/StreamReadings místo dávkového POSTu.
OF_TELEMETRY_INGEST_BASE_URL={{ of_telemetry_ingest_base_url }}
OF_TELEMETRY_INGEST_GRPC_ADDR={{ of_telemetry_ingest_grpc_addr }}
OF_EDGE_TRANSPORT={{ 'grpc_stream' if of_edge_stable_link | default(false) | bool else 'http_batch' }}

# Dávkování. Strop musí zůstat pod OF_TELEMETRY_BATCH_MAX_READINGS na straně
# ingestu, jinak celá dávka skončí 413 a agent ji bude opakovat donekonečna.
OF_EDGE_BATCH_MAX_READINGS={{ of_edge_batch_max_readings }}
OF_EDGE_BATCH_FLUSH_INTERVAL_MS={{ of_edge_batch_flush_interval_ms }}
OF_EDGE_BATCH_COMPRESSION={{ of_edge_batch_compression }}
OF_EDGE_HEARTBEAT_INTERVAL_SECONDS={{ of_edge_heartbeat_interval_seconds }}

# Spool. Když se naplní, agent zahazuje nejstarší čtení — ne nejnovější:
# aktuální teplota reeferu je provozně cennější než hodina stará.
OF_EDGE_SPOOL_DIR={{ of_edge_spool_dir }}
OF_EDGE_SPOOL_MAX_BYTES={{ of_edge_spool_max_bytes }}
OF_EDGE_REPLAY_RETENTION_DAYS={{ of_edge_replay_retention_days }}

# Sériové linky koncentrátorů senzorových uzlů (firmware/).
OF_EDGE_SERIAL_DEVICES={{ of_edge_serial_devices | join(',') }}
OF_EDGE_SERIAL_BAUD={{ of_edge_serial_baud }}

OF_OTEL_EXPORTER_ENDPOINT={{ of_otel_exporter_endpoint }}
OF_OTEL_SAMPLE_RATIO={{ of_otel_sample_ratio }}
OF_SHUTDOWN_GRACE_SECONDS={{ of_shutdown_grace_seconds }}
