# =============================================================================
# Prostředí jedné služby ORBITALFREIGHT.
#
# Soubor se generuje rolí of_service a čte ho systemd přes EnvironmentFile.
# Struktura kopíruje §5 SPEC.md: nejdřív blok, který čte každá služba (§5.1),
# pak adresy podle grafu §1.1, pak proměnné vlastní té jedné službě (§5.2-§5.15).
#
# Zásada, kterou nepřepisovat: co tu není v §5, to tu nesmí být vůbec. Služba,
# která najde OF_* proměnnou neuvedenou ve specifikaci, podle §5 selže při
# startu — a selže na všech instancích naráz, protože prostředí je všude stejné.
#
# NEEDITOVAT NA STROJI. Přepíše první běh site.yml.
# =============================================================================

# --- §5.1 čte každá služba ---------------------------------------------------
OF_ENVIRONMENT={{ of_environment }}
OF_REGION_CODE={{ of_region }}
OF_SERVICE_NAME={{ of_service.name }}
OF_LOG_LEVEL={{ of_log_level }}
OF_LOG_FORMAT={{ of_log_format }}
OF_HTTP_PORT={{ of_service.http_port }}
{% if of_service.grpc_port %}
OF_GRPC_PORT={{ of_service.grpc_port }}
{% else %}
# OF_GRPC_PORT se nenastavuje: {{ of_service.name }} nemá podle §1 gRPC surface.
{% endif %}
{% if of_service.schema %}
OF_DATABASE_URL=postgres://{{ vault_db_users[of_service.name] }}:{{ vault_db_passwords[of_service.name] }}@{{ of_postgres_endpoint }}:5432/orbitalfreight?search_path={{ of_service.schema }}&application_name={{ of_service.name }}&sslmode=verify-full
OF_DATABASE_MAX_CONNS={{ of_database_max_conns }}
OF_DATABASE_STATEMENT_TIMEOUT_MS={{ of_database_statement_timeout_ms }}
{% endif %}
OF_KAFKA_BROKERS={{ of_kafka_brokers }}
{% if of_service.name in of_service_kafka_consumers %}
OF_KAFKA_CONSUMER_GROUP={{ of_service.consumer_group }}
{% endif %}
OF_OTEL_EXPORTER_ENDPOINT={{ of_otel_exporter_endpoint }}
OF_OTEL_SAMPLE_RATIO={{ of_otel_sample_ratio }}
OF_IDENTITY_GRPC_ADDR={{ of_identity_grpc_addr }}
OF_IDENTITY_JWKS_URL={{ of_identity_jwks_url }}
OF_IDENTITY_JWKS_GRACE_SECONDS={{ of_identity_jwks_grace_seconds }}
OF_OUTBOX_RELAY_INTERVAL_MS={{ of_outbox_relay_interval_ms }}
OF_SHUTDOWN_GRACE_SECONDS={{ of_shutdown_grace_seconds }}

# --- adresy podle synchronního grafu §1.1 ------------------------------------
{% set outbound = of_service_outbound[of_service.name] | default([]) %}
{% if outbound | length == 0 %}
# {{ of_service.name }} nevolá nikoho kromě identity-service.
{% else %}
{% for target in outbound %}
{% set mapping = of_service_address_var[target] %}
{{ mapping.var }}={{ hostvars[inventory_hostname][mapping.value_key] }}
{% endfor %}
{% endif %}

# --- proměnné vlastní službě (§5.2 až §5.15) ---------------------------------
{% set own = of_service_settings[of_service.name] | default({}) %}
{% set overrides = (of_service_overrides | default({}))[of_service.name] | default({}) %}
{% for key, value in (own | combine(overrides)) | dictsort %}
{{ key }}={{ value }}
{% endfor %}
{% for key, value in (of_service_extra_env | default({})) | dictsort %}
{{ key }}={{ value }}
{% endfor %}
